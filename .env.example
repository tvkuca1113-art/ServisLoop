# =============================================================================
# ServisLoop — primjer konfiguracije okruženja
# =============================================================================
# Kopiraj ovaj fajl u `.env.local` i popuni stvarnim vrijednostima:
#
#     cp .env.example .env.local
#
# NIKAD ne commitaj `.env.local` u git. Fajl je već u `.gitignore`.
#
# Varijable koje počinju sa NEXT_PUBLIC_ vidljive su u pregledniku.
# Sve ostale ostaju isključivo na serveru.
# Provjera ispravnosti radi se pri pokretanju u `lib/env.ts` — ako nešto
# nedostaje, aplikacija se neće pokrenuti s nejasnom greškom nego s jasnom
# porukom koja tačno kaže koja varijabla fali.
# =============================================================================


# -----------------------------------------------------------------------------
# 1. APLIKACIJA
# -----------------------------------------------------------------------------

# Puni URL na kojem aplikacija radi. Bez kose crte na kraju.
# Lokalno:   http://localhost:3000
# Produkcija: https://app.servisloop.ba
NEXT_PUBLIC_APP_URL=http://localhost:3000

# `development` | `production` | `test` — Next.js ovo postavlja sam,
# ne treba ga ručno definisati.


# -----------------------------------------------------------------------------
# 2. SUPABASE  (baza podataka, autentifikacija, storage)
#    Gdje naći: Supabase projekt → Project Settings → API
#    Detaljno uputstvo: docs/SUPABASE_SETUP.md
# -----------------------------------------------------------------------------

# URL projekta, npr. https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# "anon / public" ključ. Smije biti u pregledniku — RLS ga ograničava.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key

# "service_role" ključ. ZAOBILAZI RLS.
# Koristi se ISKLJUČIVO na serveru: cron poslovi, javne QR rute, admin.
# Ako ovaj ključ procuri, neko može pročitati sve podatke svih organizacija.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key

# Direktna PostgreSQL veza — koristi se SAMO za migracije, seed i testove
# (`npm run db:migrate`, `npm run db:seed`, `npm run test:integration`).
# Aplikacija u runtime-u je NE koristi.
# Gdje naći: Supabase → Project Settings → Database → Connection string → URI
DATABASE_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres


# -----------------------------------------------------------------------------
# 3. E-POŠTA  (Resend)
#    Detaljno uputstvo: docs/EMAIL_SETUP.md
# -----------------------------------------------------------------------------

# API ključ sa resend.com → API Keys. Počinje sa `re_`.
# Ako je prazan, aplikacija radi u načinu "email preview":
# poruke se NE šalju nego se zapisuju u bazu i vide na /app/podsjetnici.
# To znači da cijeli motor podsjetnika možeš testirati bez plaćenog plana.
RESEND_API_KEY=

# Adresa pošiljaoca. Domena mora biti verifikovana u Resend-u.
# Format: "Ime <adresa@domena>"
EMAIL_FROM=ServisLoop <servis@servisloop.ba>

# Adresa na koju stižu odgovori kupaca.
EMAIL_REPLY_TO=podrska@servisloop.ba

# Kada je `1`, nijedna e-pošta se ne šalje stvarno — sve ide u bazu
# i vidljivo je u pregledniku. Obavezno `1` u testovima.
EMAIL_DRY_RUN=0


# -----------------------------------------------------------------------------
# 4. RASPOREĐENI POSLOVI (cron)
#    Detaljno uputstvo: docs/VERCEL_DEPLOYMENT.md → "Cron"
# -----------------------------------------------------------------------------

# Tajna koja štiti /api/cron/*. Vercel je šalje kao `Authorization: Bearer <tajna>`.
# Generiši sa:  openssl rand -base64 32
CRON_SECRET=promijeni-me-generisanom-tajnom-od-najmanje-32-znaka


# -----------------------------------------------------------------------------
# 5. JAVNI TOKENI (QR kodovi, linkovi za rezervaciju i izvještaje)
# -----------------------------------------------------------------------------

# Tajna kojom se heširaju javni tokeni prije pohrane u bazu.
# Ako je promijeniš, SVI postojeći QR kodovi i linkovi prestaju raditi.
# Generiši sa:  openssl rand -base64 48
PUBLIC_TOKEN_SECRET=promijeni-me-generisanom-tajnom-od-najmanje-32-znaka


# -----------------------------------------------------------------------------
# 6. IZVJEŠTAJI / PDF
# -----------------------------------------------------------------------------

# Prefiks broja izvještaja, npr. SL-2026-000123
REPORT_NUMBER_PREFIX=SL

# Koliko dana vrijedi tokenizirani link ka PDF izvještaju (0 = bez isteka).
REPORT_LINK_TTL_DAYS=365


# -----------------------------------------------------------------------------
# 7. ADMINISTRACIJA
# -----------------------------------------------------------------------------

# Lista e-mail adresa (odvojenih zarezom) koje smiju otvoriti /app/admin.
# Provjera je isključivo serverska. Prazno = niko nema pristup.
SUPER_ADMIN_EMAILS=


# -----------------------------------------------------------------------------
# 8. OPCIONALNE FUNKCIJE
# -----------------------------------------------------------------------------

# Demo način: dopušta prijavu u demo organizaciju sa /demo stranice.
NEXT_PUBLIC_DEMO_MODE=1

# Interna analitika (tabela `analytics_events`). Bez vanjskih servisa.
NEXT_PUBLIC_ANALYTICS_ENABLED=1

# OPCIONALNO: Anthropic API ključ za pomoćne AI funkcije.
# Aplikacija radi potpuno normalno i bez njega — sve AI funkcije su
# dodatak, nikad uslov. Ostavi prazno ako ih ne želiš.
ANTHROPIC_API_KEY=

# Model koji se koristi ako je AI uključen.
ANTHROPIC_MODEL=claude-haiku-4-5-20251001


# -----------------------------------------------------------------------------
# 9. TESTIRANJE  (samo lokalno / CI — ne postavljati na Vercelu)
# -----------------------------------------------------------------------------

# Baza protiv koje idu integracijski testovi i provjera RLS izolacije.
# UPOZORENJE: `npm run test:integration` briše i ponovo kreira šemu.
# NIKAD ne pokazuj ovo na produkcijsku bazu.
TEST_DATABASE_URL=

# Port na kojem Playwright pokreće aplikaciju.
E2E_PORT=3100
